SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SOLANA_RPC_URL=YOUR_SOLANA_MAINNET_RPC_URL

# Dedicated Solana creator-fee wallet. This is NOT the token mint.
BBL_SOL_WALLET_ADDRESS=YOUR_CREATOR_FEE_WALLET_ADDRESS
BBL_SOL_WALLET_PRIVATE_KEY=YOUR_CREATOR_FEE_WALLET_PRIVATE_KEY
BBL_SOL_FEE_BUFFER_SOL=0.05
BBL_TOKEN_ADDRESS=

# Copy the unique Solana deposit address shown by Hyperliquid's SOL deposit flow.
BBL_HYPERLIQUID_SOL_DEPOSIT_ADDRESS=YOUR_UNIQUE_HYPERLIQUID_SOL_DEPOSIT_ADDRESS
BBL_MIN_ROUTE_SOL=0.12
BBL_HYPERLIQUID_ACCOUNT=YOUR_0X_HYPERLIQUID_ACCOUNT

HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
# Approved agent/API wallet signer for spot orders.
HYPERLIQUID_API_WALLET_PRIVATE_KEY=YOUR_APPROVED_AGENT_PRIVATE_KEY
HYPERLIQUID_MANAGED_SPOT_USDC=false
BBL_ANSEM_SPOT_EXECUTION_CONFIRMED=false
BBL_MAX_SPOT_USDC_PER_RUN=25
HYPERLIQUID_MAX_SLIPPAGE_BPS=100
HYPERLIQUID_MIN_TRADE_USDC=10
HYPERLIQUID_SPOT_USDC_BUFFER=1
HYPERLIQUID_DEPOSIT_POLL_SECONDS=90

CLAIM_INTERVAL_MINUTES=15
DRY_RUN=true

# Optional platform claim adapter. Leave blank when creator fees already route
# directly to BBL_SOL_WALLET_ADDRESS.
CREATOR_FEE_CLAIM_ENDPOINT=
CREATOR_FEE_CLAIM_API_KEY=

# Optional later-stage strategy adapters. They never run unless configured.
BBL_PROFIT_ENDPOINT=
BBL_PROFIT_API_KEY=
BBL_BUYBACK_BURN_ENDPOINT=
BBL_BUYBACK_BURN_API_KEY=
