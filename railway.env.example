SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SOLANA_RPC_URL=YOUR_SOLANA_MAINNET_RPC_URL

# Dedicated Solana creator-fee wallet. This is not the token mint.
BBL_SOL_WALLET_ADDRESS=YOUR_CREATOR_FEE_WALLET_ADDRESS
BBL_SOL_WALLET_PRIVATE_KEY=YOUR_CREATOR_FEE_WALLET_PRIVATE_KEY
BBL_SOL_FEE_BUFFER_SOL=0.05
BBL_TOKEN_ADDRESS=3LdsM35gCW2u99taAN6kKChhkGNR5yMDzAb15vcRpump

# Public Aster account used by the site position tracker.
BBL_ASTER_WALLET_ADDRESS=0xe7BdaB66180a514bb591E2cD6874e58CE5809488
ASTER_PUBLIC_RPC_URL=https://tapi.asterdex.com/info

# Aster execution API. Keep these private and rotate them if exposed.
ASTER_API_URL=https://fapi.asterdex.com
ASTER_API_KEY=
ASTER_API_SECRET=
BBL_ASTER_LEVERAGE=5
ASTER_MANAGED_USDT=false
BBL_ASTER_EXECUTION_CONFIRMED=false
BBL_MAX_COLLATERAL_USDT_PER_RUN=25
ASTER_USDT_BUFFER=5

CLAIM_INTERVAL_MINUTES=15
DRY_RUN=true

# Optional platform claim adapter. Leave blank when creator fees already route
# directly to BBL_SOL_WALLET_ADDRESS.
CREATOR_FEE_CLAIM_ENDPOINT=
CREATOR_FEE_CLAIM_API_KEY=

# Required before live creator-fee funds can reach the Aster account.
BBL_ASTER_FUND_ENDPOINT=
BBL_ASTER_FUND_API_KEY=

# Optional profit realization and buyback/burn adapters.
BBL_PROFIT_ENDPOINT=
BBL_PROFIT_API_KEY=
BBL_BUYBACK_BURN_ENDPOINT=
BBL_BUYBACK_BURN_API_KEY=
